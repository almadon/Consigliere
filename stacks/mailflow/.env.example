# Copy to .env (never commit the real one) and fill in. Keep a copy of .env somewhere safe: losing ENCRYPTION_KEY makes every stored
# mailbox credential unreadable (users would have to add their accounts again).
MAILFLOW_VERSION=4.0.2           # a released version (github.com/maathimself/mailflow/releases); the images exist for amd64 and arm64
APP_URL=https://mail.a64.one     # the public https address (set by the route you publish)
SESSION_SECRET=                  # openssl rand -hex 32
DB_PASSWORD=                     # openssl rand -hex 16
ENCRYPTION_KEY=                  # openssl rand -hex 32
TRUST_PROXY_HOPS=1
# Web Push (optional): a VAPID key pair, once. Generate it inside the backend container with the command in README.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://mail.a64.one    # a contact URL (or mailto:) that push services can see
