# --- OIDC login (Pocket ID) ---
# Register Consigliere console as an OIDC client in Pocket ID first; redirect URI
# is `${NEXTAUTH_URL}/api/auth/callback/pocket-id`.
POCKET_ID_URL=https://id.example.ts.net
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=

NEXTAUTH_URL=https://consigliere.example.ts.net
NEXTAUTH_SECRET=   # generate with: openssl rand -base64 32

# --- Machine data source ---
# "outline" today; the provider interface (src/lib/providers/types.ts) is
# what a future NetBox/other backend would implement.
MACHINE_PROVIDER=outline

# Self-hosted Outline instance + API token (Settings -> API in Outline).
OUTLINE_API_URL=https://outline.example.ts.net
OUTLINE_API_TOKEN=
# Collection containing one document per machine (see console/README.md
# for the expected per-doc table convention).
OUTLINE_COLLECTION_ID=
# Optional: a doc containing a `<!-- consigliere:overview:start -->` /
# `<!-- consigliere:overview:end -->` marker pair. POSTing /api/sync regenerates
# the table between those markers from every machine doc, so the overview
# becomes generated instead of hand-maintained. Leave blank to skip.
OUTLINE_OVERVIEW_DOC_ID=

# --- Optional: live reachability status via the tailnet ---
# Leave blank to skip - machines just render without an online/offline dot.
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=-

# --- Authorization (fail closed: unset = nobody gets in) ---
# Pocket ID user-group names, delivered in the `groups` claim. Create the
# groups in Pocket ID and put users in them; the OIDC client must be allowed
# the `groups` scope. Admin implies viewer.
CONSOLE_VIEWER_GROUP=
CONSOLE_ADMIN_GROUP=
