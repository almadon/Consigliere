#!/bin/sh
# Managed by Ansible (hosts/roles/tailscale). Enables UDP GRO forwarding on the default-route
# interface, as Tailscale recommends. Quietly does nothing where the NIC cannot do it.
dev="$(ip -o route get 1.1.1.1 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n1)"
[ -n "$dev" ] || exit 0
ethtool -K "$dev" rx-udp-gro-forwarding on rx-gro-list off 2>/dev/null || exit 0
