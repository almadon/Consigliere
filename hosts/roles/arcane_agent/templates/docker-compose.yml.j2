# Managed by Ansible (hosts/roles/arcane_agent) -- edits here get
# overwritten on the next reconciliation run. Matches the compose the Arcane
# manager's "edge agent" wizard generates: the agent connects OUTBOUND to the
# manager, so no ports are published on this host.
services:
  arcane-edge-agent:
    image: ghcr.io/getarcaneapp/agent:{{ arcane_agent_version }}
    container_name: arcane-edge-agent
    restart: unless-stopped
    environment:
      - EDGE_AGENT=true
      - EDGE_TRANSPORT={{ arcane_agent_edge_transport }}
      - AGENT_TOKEN={{ arcane_agent_token }}
      - MANAGER_API_URL={{ arcane_server_api_url }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - arcane-data:/app/data

volumes:
  arcane-data:
