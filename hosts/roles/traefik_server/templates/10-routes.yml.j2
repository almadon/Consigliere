# Managed by Ansible (hosts/roles/traefik_server) -- edits get overwritten.
# This host's routes, collected from traefik_server_routes* variables (and static_sites).
{% set ns = namespace(all=[]) %}
{% for src in _traefik_server_sources %}
{% for r in lookup('vars', src) %}
{% set ns.all = ns.all + [dict(r, _src=src)] %}
{% endfor %}
{% endfor %}
{% for st in traefik_server_static_sites %}
{% set sh = [st.host] if st.host is string else st.host %}
{% set srule = ({'rule': '(' ~ (sh | map('regex_replace', '^(.*)$', 'Host(`\\1`)') | join(' || ')) ~ ') && (' ~ (st.paths | map('regex_replace', '^(.*)$', 'Path(`\\1`)') | join(' || ')) ~ ')'} if st.paths is defined else {}) %}
{% set sx = {} %}
{% for k in ['profile', 'csp_extra', 'frame_ancestors'] %}
{% if st[k] is defined %}{% set _ = sx.update({k: st[k]}) %}{% endif %}
{% endfor %}
{% set ns.all = ns.all + [({'name': st.name, 'host': st.host, 'backend': 'http://traefik-static:8080', '_src': 'traefik_server_static_sites'} | combine(srule) | combine(sx))] %}
{% endfor %}
{% if ns.all | length == 0 %}
{}
{% else %}
http:
  routers:
{% for r in ns.all %}
{% set hosts = r.host if (r.host is defined and r.host is not string) else ([r.host] if r.host is defined else []) %}
{% set profile = r.profile | default(traefik_server_default_profile) %}
{% set normal = (['compress@file'] if (r.compress | default(true)) else []) + (['sec-' ~ (r.name if (r.csp_extra is defined or r.frame_ancestors is defined) else profile) ~ '@file'] if profile != 'none' else []) + (r.middlewares | default([])) %}
{% set internal = namespace(on=(r.internal | default(false) | bool)) %}
{% for h in hosts %}{% for d in traefik_server_internal_domains %}{% if h == d or h.endswith('.' ~ d) %}{% set internal.on = true %}{% endif %}{% endfor %}{% endfor %}
{% set chain = (['internal-only@file'] if internal.on else []) + (['redirect-' ~ r.name ~ '@file'] if r.redirect is defined else normal) %}
    # from {{ r._src }}
    {{ r.name }}:
      rule: {{ (r.rule | default(hosts | map('regex_replace', '^(.*)$', 'Host(`\\1`)') | join(' || '))) | to_json }}
      entryPoints: [{{ traefik_server_entrypoint_websecure }}]
      service: {{ 'noop@internal' if r.redirect is defined else r.name }}
{% if chain | length > 0 %}
      middlewares: {{ chain | to_json }}
{% endif %}
      tls: {}
{% endfor %}
{% if ns.all | selectattr('redirect', 'defined') | list | length > 0 %}
  middlewares:
{% for r in ns.all | selectattr('redirect', 'defined') %}
    redirect-{{ r.name }}:
      redirectRegex:
        regex: "^https?://[^/]+(.*)$"
        replacement: {{ (r.redirect.to | trim('/') ~ '${1}') | to_json }}
        permanent: {{ (r.redirect.permanent | default(true)) | bool | lower }}
{% endfor %}
{% endif %}
  services:
{% for r in ns.all | rejectattr('redirect', 'defined') %}
    {{ r.name }}:
      loadBalancer:
{% if r.pass_host_header is defined and not r.pass_host_header %}
        passHostHeader: false
{% endif %}
{% if r.insecure | default(false) %}
        serversTransport: insecure@file
{% endif %}
        servers:
          - url: {{ r.backend | to_json }}
{% endfor %}
{% endif %}
