# Managed by Ansible (hosts/roles/traefik_server) -- edits get overwritten.
# Security profiles (headers), compression, TLS policy and backend transports. Routes pick
# a profile with `profile:`; see the role's defaults for what each one does.
{% macro headers(csp, framed=false) %}
    headers:
      stsSeconds: {{ traefik_server_hsts_seconds }}
      stsIncludeSubdomains: true
      stsPreload: {{ traefik_server_hsts_preload | bool | lower }}
      forceSTSHeader: true
      contentTypeNosniff: true
{% if not framed %}
      customFrameOptionsValue: SAMEORIGIN
{% endif %}
      referrerPolicy: {{ traefik_server_referrer_policy | to_json }}
      permissionsPolicy: {{ (traefik_server_permissions_policy | trim) | to_json }}
{% if csp %}
      contentSecurityPolicy: {{ (csp | trim) | to_json }}
{% endif %}
      customResponseHeaders:
        Server: ""
        X-Powered-By: ""
        X-Permitted-Cross-Domain-Policies: "none"
{% endmacro %}
{# A profile's CSP with a route's additions: csp_extra {directive: [sources]} is appended to the directive of that name (a directive the profile lacks is added as
   "<directive> 'self' <sources>"), frame_ancestors [origins] to frame-ancestors (added when the profile has no CSP). #}
{% macro merged_csp(base, extra, ancestors) -%}
{%- set ns = namespace(out=[], seen=[]) -%}
{%- for part in (base | replace('\n', ' ')).split(';') -%}
{%- set d = part | trim -%}
{%- if d -%}
{%- set name = d.split(' ')[0] -%}
{%- set ns.seen = ns.seen + [name] -%}
{%- if name == 'frame-ancestors' and ancestors -%}
{%- set d = d ~ ' ' ~ (ancestors | join(' ')) -%}
{%- elif name in extra -%}
{%- set d = d ~ ' ' ~ (extra[name] | join(' ')) -%}
{%- endif -%}
{%- set ns.out = ns.out + [d] -%}
{%- endif -%}
{%- endfor -%}
{%- for name, srcs in extra.items() if name not in ns.seen -%}
{%- set ns.out = ns.out + [name ~ " 'self' " ~ (srcs | join(' '))] -%}
{%- endfor -%}
{%- if ancestors and 'frame-ancestors' not in ns.seen -%}
{%- set ns.out = ns.out + ["frame-ancestors 'self' " ~ (ancestors | join(' '))] -%}
{%- endif -%}
{{ ns.out | join('; ') }}
{%- endmacro %}
http:
  middlewares:
    compress:
      compress: {}
    # Only the private ranges (LAN, tailnet) may use a route that carries this: `internal: true` on a route, or any route under
    # traefik_server_internal_domains. The check is on the connection's own address, never on a header the client sent.
    internal-only:
      ipAllowList:
        sourceRange: {{ traefik_server_internal_sources | to_json }}
    sec-app:
{{ headers(traefik_server_csp_app) | indent(2, true) }}
    sec-strict:
{{ headers(traefik_server_csp_strict) | indent(2, true) }}
    sec-relaxed:
{{ headers('') | indent(2, true) }}
    sec-framed:
{{ headers('', true) | indent(2, true) }}
{# one security middleware of its own for each route that adds to its CSP or may be embedded by other sites #}
{% for r in _traefik_server_routes if (r.csp_extra is defined or r.frame_ancestors is defined) and r.redirect is not defined %}
{% set prof = r.profile | default(traefik_server_default_profile) %}
{% set base = traefik_server_csp_app if prof == 'app' else (traefik_server_csp_strict if prof == 'strict' else '') %}
    sec-{{ r.name }}:
{{ headers(merged_csp(base, r.csp_extra | default({}), r.frame_ancestors | default([])), (prof == 'framed') or (r.frame_ancestors is defined)) | indent(2, true) }}
{% endfor %}
{% for name, body in traefik_server_extra_middlewares.items() %}
    {{ name }}: {{ body | to_json }}
{% endfor %}
  serversTransports:
    insecure:
      insecureSkipVerify: true
tls:
  options:
    default:
      minVersion: {{ traefik_server_tls_min_version }}
      sniStrict: {{ traefik_server_tls_sni_strict | bool | lower }}
      cipherSuites:
        - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256
        - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
        - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
