# Managed by Ansible (hosts/roles/traefik_server) -- edits here get overwritten on the next
# reconciliation run. Change the role's defaults / fleet vars instead.
name: traefik

services:
  traefik:
    image: traefik:{{ traefik_server_version }}
    container_name: traefik
    restart: unless-stopped
    ports:
      - "{{ traefik_server_http_port }}:80"
      - "{{ traefik_server_https_port }}:443"
    volumes:
      - {{ traefik_server_dir }}/dynamic:/dynamic:ro
      - {{ traefik_server_certs_dir }}:/certs:ro
    configs:
      - source: static
        target: /etc/traefik/traefik.yml
{% if traefik_server_networks | length > 0 %}
    networks: {{ traefik_server_networks | to_json }}
{% endif %}
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 15s
      timeout: 3s
      retries: 3
{% if traefik_server_static_sites | length > 0 %}

  # Serves the static_sites (Traefik routes to it as http://traefik-static:8080).
  static:
    image: nginxinc/nginx-unprivileged:{{ traefik_server_static_version }}
    container_name: traefik-static
    restart: unless-stopped
    read_only: true
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp
    volumes:
      - {{ traefik_server_dir }}/static-sites.conf:/etc/nginx/conf.d/default.conf:ro
{% for st in traefik_server_static_sites %}
      - {{ st.root }}:/sites/{{ st.name }}:ro
{% endfor %}
    networks: {{ (traefik_server_networks[:1] if traefik_server_networks | length > 0 else ['default']) | to_json }}
{% endif %}

# The static file is passed as a compose config, so changing it recreates the container.
configs:
  static:
    file: {{ traefik_server_dir }}/traefik.yml
{% if traefik_server_networks | length > 0 %}

networks:
{% for n in traefik_server_networks %}
  {{ n }}:
    external: true
{% endfor %}
{% endif %}
