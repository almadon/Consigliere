# Managed by Ansible (hosts/roles/otel_agent) -- edits here get overwritten on the next reconciliation run.
extensions:
  file_storage:
    directory: /var/lib/otelcol-contrib/storage

receivers:
{% if otel_agent_journal | bool %}
  journald:
    priority: {{ otel_agent_journal_priority }}
    storage: file_storage
{% endif %}
{% if _otel_agent_docker %}
  file_log/docker:
    include: [/var/lib/docker/containers/*/*-json.log]
    include_file_path: true
    start_at: end
    storage: file_storage
    operators:
      - type: json_parser
        timestamp:
          parse_from: attributes.time
          layout: '%Y-%m-%dT%H:%M:%S.%LZ'
      - type: regex_parser
        regex: '^/var/lib/docker/containers/(?P<container_id>[0-9a-f]{64})/'
        parse_from: attributes["log.file.path"]
        on_error: send_quiet
      # Container names are looked up in a table written at each reconcile (docker ps); a container newer than the table is
      # labelled c-<short id> until the next run.
      - type: add
        field: resource["container.name"]
        value: 'EXPR({{ _otel_agent_container_names | to_json }}[attributes.container_id] ?? ("c-" + attributes.container_id[:12]))'
      - type: move
        from: attributes.log
        to: body
      - type: move
        from: attributes.stream
        to: attributes["log.iostream"]
      - type: remove
        field: attributes.time
      - type: remove
        field: attributes.container_id
{% endif %}
{% if otel_agent_hostmetrics | bool %}
  hostmetrics:
    collection_interval: {{ otel_agent_hostmetrics_interval }}
    scrapers:
      cpu:
        metrics:
          system.cpu.utilization: {enabled: true}
      memory:
        metrics:
          system.memory.utilization: {enabled: true}
      load: {}
      filesystem:
        metrics:
          system.filesystem.utilization: {enabled: true}
        exclude_fs_types:
          match_type: strict
          fs_types: [autofs, binfmt_misc, bpf, cgroup, cgroup2, configfs, debugfs, devpts, devtmpfs, fusectl, hugetlbfs, mqueue, nsfs, overlay, proc, procfs, pstore, rpc_pipefs, securityfs, selinuxfs, squashfs, sysfs, tmpfs, tracefs]
        exclude_mount_points:
          match_type: regexp
          mount_points: ["/var/lib/docker/.*", "/run/.*", "/snap/.*", "/sys/.*", "/proc/.*", "/dev/.*", "/var/lib/containers/.*"]
{% endif %}
{% if _otel_agent_relay %}
  otlp/metrics:
    protocols:
      http:
        endpoint: {{ otel_agent_otlp_listen | to_json }}
{% endif %}
{% for l in otel_agent_syslog_listeners %}
  syslog/{{ l.name }}:
    {{ l.transport }}:
      listen_address: {{ l.listen | to_json }}
    protocol: {{ l.protocol | default('rfc3164') }}
    location: {{ otel_agent_syslog_timezone | to_json }}
    operators:
      # The sender's own name, not this relay's: a message is stored as host_name=<sender>, unit=<program>. A line the parser cannot fully
      # read (wrong protocol for the sender) is still delivered, as host_name=unknown, rather than dropped.
      - type: add
        field: resource["host.name"]
        value: 'EXPR(lower(attributes.hostname ?? "unknown"))'
        on_error: send_quiet
      - type: add
        field: resource["syslog.listener"]
        value: {{ l.name | to_json }}
        on_error: send_quiet
      - type: move
        from: attributes.appname
        to: attributes.unit
        if: 'attributes.appname != nil'
        on_error: send_quiet
      - type: move
        from: attributes.message
        to: body
        if: 'attributes.message != nil'
        on_error: send_quiet
      - type: remove
        field: attributes.hostname
        if: 'attributes.hostname != nil'
        on_error: send_quiet
{% endfor %}

processors:
  memory_limiter:
    check_interval: 5s
    limit_mib: {{ otel_agent_memory_limit_mib }}
    spike_limit_mib: {{ (otel_agent_memory_limit_mib | int / 4) | int }}
  resource:
    attributes:
      - {key: host.name, value: {{ otel_agent_host_name | to_json }}, action: upsert}
{% for k, v in otel_agent_attributes.items() %}
      - {key: {{ k | to_json }}, value: {{ v | to_json }}, action: upsert}
{% endfor %}
{% if otel_agent_journal | bool %}
  # A journal entry arrives with its fields as the body; keep the message as the body and the unit as the attribute "unit".
  transform/journald:
    error_mode: ignore
    log_statements:
      - context: log
        statements:
          - set(attributes["unit"], body["_SYSTEMD_UNIT"]) where body["_SYSTEMD_UNIT"] != nil
          - set(attributes["unit"], body["SYSLOG_IDENTIFIER"]) where attributes["unit"] == nil and body["SYSLOG_IDENTIFIER"] != nil
          - set(attributes["unit"], "kernel") where attributes["unit"] == nil and body["_TRANSPORT"] == "kernel"
          # Keep the label values few and stable: transient units (SSH sessions, container scopes, systemd-run jobs) would otherwise
          # create a new stream every time.
          - replace_pattern(attributes["unit"], "\\.service$", "") where attributes["unit"] != nil
          - replace_pattern(attributes["unit"], "^session-[A-Za-z0-9]+\\.scope$", "session") where attributes["unit"] != nil
          - replace_pattern(attributes["unit"], "^(docker|libpod|cri-containerd)-[0-9a-f]+\\.scope$", "$$1") where attributes["unit"] != nil
          - replace_pattern(attributes["unit"], "^run-.*$", "run") where attributes["unit"] != nil
          - replace_pattern(attributes["unit"], "@[0-9]+", "@N") where attributes["unit"] != nil
          - set(body, body["MESSAGE"]) where body["MESSAGE"] != nil
{% endif %}
  batch: {}

exporters:
  otlp_http/loki:
    endpoint: {{ otel_agent_loki_url | to_json }}
    sending_queue:
      storage: file_storage
    retry_on_failure:
      max_elapsed_time: 0s

{% if _otel_agent_metrics %}
  otlp_http/victoria:
    endpoint: {{ otel_agent_metrics_url | to_json }}
    sending_queue:
      storage: file_storage
    retry_on_failure:
      max_elapsed_time: 0s
{% endif %}

service:
  extensions: [file_storage]
  pipelines:
{% if otel_agent_journal | bool %}
    logs/journal:
      receivers: [journald]
      processors: [memory_limiter, transform/journald, resource, batch]
      exporters: [otlp_http/loki]
{% endif %}
{% if _otel_agent_docker %}
    logs/docker:
      receivers: [file_log/docker]
      processors: [memory_limiter, resource, batch]
      exporters: [otlp_http/loki]
{% endif %}
{% if otel_agent_syslog_listeners | length > 0 %}
    logs/syslog:
      receivers: [{% for l in otel_agent_syslog_listeners %}syslog/{{ l.name }}{{ ', ' if not loop.last }}{% endfor %}]
      processors: [memory_limiter, batch]
      exporters: [otlp_http/loki]
{% endif %}
{% if _otel_agent_relay %}
    metrics/relay:
      receivers: [otlp/metrics]
      processors: [memory_limiter, resource, batch]
      exporters: [otlp_http/victoria]
{% endif %}
{% if otel_agent_hostmetrics | bool %}
    metrics/host:
      receivers: [hostmetrics]
      processors: [memory_limiter, resource, batch]
      exporters: [otlp_http/victoria]
{% endif %}
  telemetry:
    logs:
      level: warn
    # The collector's own metrics endpoint (127.0.0.1:8888) is off: nothing scrapes it, and another service may already own that port.
    metrics:
      level: none
