# Managed by Ansible (hosts/roles/otel_agent) -- edits here get overwritten on the next reconciliation run.
# Read-only view of Docker's API for the collector's docker_stats receiver (container list, inspect, stats, events). Nothing can be changed through it.
services:
  otel-docker-proxy:
    image: tecnativa/docker-socket-proxy:{{ otel_agent_docker_proxy_version }}
    container_name: otel-docker-proxy
    environment:
      - EVENTS=1
      - PING=1
      - VERSION=1
      - CONTAINERS=1
      - INFO=1
      - POST=0
      - AUTH=0
      - SECRETS=0
      - BUILD=0
      - COMMIT=0
      - CONFIGS=0
      - DISTRIBUTION=0
      - EXEC=0
      - IMAGES=0
      - NETWORKS=0
      - NODES=0
      - PLUGINS=0
      - SERVICES=0
      - SESSION=0
      - SWARM=0
      - SYSTEM=0
      - TASKS=0
      - VOLUMES=0
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    ports:
      - "127.0.0.1:{{ otel_agent_docker_proxy_port }}:2375"
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
