# Managed by Ansible (hosts/roles/garage) -- edits here get overwritten on the next reconciliation run.
services:
  garage:
    image: dxflrs/garage:v{{ garage_version }}
    container_name: garage
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    ports:
      - "{{ garage_bind_address }}:{{ garage_s3_port }}:3900"
    volumes:
      - {{ garage_dir }}/garage.toml:/etc/garage.toml:ro
      - {{ garage_meta_dir }}:/var/lib/garage/meta
      - {{ garage_data_dir }}:/var/lib/garage/data
    healthcheck:
      test: ["CMD", "/garage", "status"]
      interval: 30s
      timeout: 10s
      start_period: 20s
{% if garage_network | length > 0 %}
    networks:
      - default
      - {{ garage_network }}
{% endif %}
{% if garage_webui_enabled | bool %}

  webui:
    image: khairul169/garage-webui:{{ garage_webui_version }}
    container_name: garage-webui
    restart: unless-stopped
    depends_on:
      - garage
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    ports:
      - "{{ garage_webui_bind_address }}:{{ garage_webui_port }}:3909"
    environment:
      API_BASE_URL: "http://garage:3903"
      S3_ENDPOINT_URL: "http://garage:3900"
      S3_REGION: {{ garage_s3_region | to_json }}
      API_ADMIN_KEY: {{ garage_admin_token | to_json }}
      # "$" is doubled so compose passes the bcrypt hash through unchanged.
      AUTH_USER_PASS: {{ garage_webui_auth | replace('$', '$$') | to_json }}
{% endif %}
{% if garage_network | length > 0 %}

networks:
  default: {}
  {{ garage_network }}:
    external: true
{% endif %}
