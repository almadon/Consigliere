# Installed by Consigliere (hosts/bootstrap/bootstrap.sh). The reconciler does not rewrite this file, and running bootstrap.sh again replaces it.
# To change it on one host, use a drop-in: systemctl edit fleet-reconcile.timer
[Unit]
Description=Run fleet reconciliation on a schedule

[Timer]
OnBootSec=2min
OnUnitActiveSec=20min
RandomizedDelaySec=3min

[Install]
WantedBy=timers.target
